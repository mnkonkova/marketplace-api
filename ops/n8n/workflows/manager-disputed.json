      "id": "tg-1",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, -100]
    },
    {
      "parameters": { "respondWith": "noData" },
      "id": "resp-1",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Is disputed", "type": "main", "index": 0 }]] },
    "Is disputed": {
      "main": [
        [{ "node": "Telegram", "type": "main", "index": 0 }],
        [{ "node": "Respond 200", "type": "main", "index": 0 }]
      ]
    },
    "Telegram": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] }
