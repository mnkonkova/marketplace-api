# .env.prod — копия для прод-VDS. cp .env.prod.example .env.prod и заполни.
# Все хосты сервисов = имена сервисов в docker-compose.prod.yml (postgres /
# opensearch / redis), наружу торчит только caddy.

APP_ENV=prod
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

# ── Домен для Caddy (Let's Encrypt). Должен резолвиться на IP сервера.
# Apex домен без поддомена (например: wayprmarket.ru). Caddy сам
# выпишет TLS для DOMAIN + www.<DOMAIN> и редирект с www на apex.
DOMAIN=

# ── PostgreSQL (compose-сервис postgres).
# Сгенерируй пароль: openssl rand -hex 16
POSTGRES_USER=marketpclce
POSTGRES_PASSWORD=
POSTGRES_DB=marketpclce
# DATABASE_URL должен использовать тот же POSTGRES_PASSWORD. host = postgres.
DATABASE_URL=postgres://marketpclce:CHANGE_ME@postgres:5432/marketpclce?sslmode=disable
# Pool sizing: читается и api, и worker'ом отдельно → итого до 2×conn к
# Postgres. 25 покрывает прод-нагрузку до ~1k DAU (см. docs/VDS_SETUP.md).
# Postgres max_connections=100 по умолчанию, 50 свободно влезает.
DATABASE_MAX_CONNS=25

# ── OpenSearch (compose-сервис opensearch). security plugin отключён,
# но образ требует admin-password ≥ 10 символов с спец-символами.
# Сгенерируй: openssl rand -base64 24
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_SPECIALISTS=specialists
OPENSEARCH_PASSWORD=

# ── Redis (compose-сервис redis).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── S3 — Yandex Object Storage.
# Static access key из service account, см. console.cloud.yandex.ru.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true
# Пустое = path-style ${endpoint}/${bucket}. Для CNAME укажи https://media.example.com
S3_PUBLIC_URL=
# CDN_BASE_URL — Yandex Cloud CDN перед bucket'ом. Пусто = читаем с origin.
# Включение через docs/CDN_SETUP.md — 5-10 минут работы в консоли Yandex,
# обратимо (выставить пустым и make redeploy).
CDN_BASE_URL=

# ── LLM. Без LLM_API_KEY эндпоинты /search/summarize и /clarify не маунтятся.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.anthropic.com
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60s
LLM_EFFORT=medium

# ── JWT. ОБЯЗАТЕЛЬНО сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

# ── Rate-limit (Redis). Дефолты подходят для беты, можно поджимать.
SUMMARIZE_CACHE_TTL=10m
RATE_SUMMARIZE_PER_MIN=5
RATE_SUMMARIZE_PER_HOUR=30
RATE_READ_PER_MIN=60
RATE_READ_PER_HOUR=600
RATE_LEADS_PER_MIN=5
RATE_LEADS_PER_HOUR=20
RATE_AUTH_PER_MIN=10
RATE_AUTH_PER_HOUR=60

# ── Email verification. В проде ОБЯЗАТЕЛЬНО:
#   - EMAIL_VERIFICATION_DISABLED=false (или не задавать — default false)
#   - N8N_EMAIL_WEBHOOK_URL заполнен (см. ниже), workflow crmEmailNotify
#     активен, в нём credential "reg.ru SMTP noreply" привязан.
#   - APP_BASE_URL = публичный URL фронта (попадает в verify-ссылку).
EMAIL_VERIFICATION_DISABLED=false
APP_BASE_URL=https://wayprmarket.ru
EMAIL_VERIFY_TOKEN_TTL=24h
RATE_EMAIL_RESEND_PER=60s

# ── Outbox-воркер ──────────────────────────────────────────────────
# Backoff/DLQ/TTL. Алерт на outbox_dead > 0 настраивается в Grafana.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_CAP=10m
OUTBOX_RETENTION=168h
OUTBOX_CLEANUP_INTERVAL=1h
WORKER_METRICS_ADDR=:9090

LOG_LEVEL=info

# ── Разрешённые origin'ы фронта (через запятую). Если фронт на том же
# домене через Caddy proxy — оставь пустым.
CORS_ORIGINS=

# ── Мониторинг через Grafana Cloud (free tier).
# Setup: grafana.com → Sign up free → My Account → Stacks → твой стек →
#   Prometheus → "Send Metrics" → возьми Remote Write Endpoint, Username,
#   и сгенерируй API key (CloudAccessPolicy с permissions metrics:write+logs:write).
# То же для Loki. Если оставить пустым — alloy запустится, но не сможет
# пушить (логи самого alloy покажут 401/connection refused).
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_KEY=
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_KEY=

# Для деплоя дашбордов и алертов из CLI:
#   make grafana-dashboards-push  # POST /api/dashboards/db
#   make grafana-rules-push       # mimirtool rules sync
# GRAFANA_URL — https://<твой-стек>.grafana.net
# GRAFANA_TOKEN — Service Account token из Grafana Cloud UI →
#   Administration → Service accounts → New → +token (роли:
#   Dashboards Admin + Rules Editor).
GRAFANA_URL=
GRAFANA_TOKEN=

# CRM v5: n8n webhook для project.* событий. Пусто → диспатчер выключен,
# события квитируются как no-op. URL = production-URL Webhook node'a
# в n8n. На проде n8n живёт за Caddy на /n8n (см. Caddyfile).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
# Workflow для email.* (verify/reset). Пусто → verify-URL печатается
# в worker.log (только для дева). См. deploy/n8n/workflows/crmEmailNotify.json
N8N_EMAIL_WEBHOOK_URL=
# Поддержка: дамп обращений в Telegram. См. deploy/n8n/workflows/crmSupport.json
N8N_SUPPORT_WEBHOOK_URL=
