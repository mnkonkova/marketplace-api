APP_ENV=local
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://marketpclce:marketpclce@localhost:5432/marketpclce?sslmode=disable
DATABASE_MAX_CONNS=10

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_SPECIALISTS=specialists

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# S3 — Yandex Object Storage (для всех окружений). Без ключей API стартует,
# /me/portfolio/upload-url возвращает 503 storage_disabled — для локалки
# можно оставить пустыми, если не работаешь с аплоадом видео.
# Static access key из service account: console.cloud.yandex.ru.
#
# Разделение ключей по принципу наименьших привилегий:
#  - S3_ACCESS_KEY / S3_SECRET_KEY — UPLOAD-ONLY, используется API для
#    подписи presigned PUT. Не нужны list/delete права.
#  - S3_SWEEP_ACCESS_KEY / S3_SWEEP_SECRET_KEY — list + delete, для
#    orphan-sweep'a в worker'е и cmd/s3-sweep-once. Если пусты —
#    sweep выключен (no-op), фронт-аплоад продолжает работать.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true
# Пустое = path-style ${endpoint}/${bucket}. Или CNAME: https://media.example.com
S3_PUBLIC_URL=
# Yandex Cloud CDN перед bucket'ом (опционально). Пусто = читаем напрямую с
# origin. Заполнено = PublicURL отдаёт CDN-домен юзерам (presigned PUT
# по-прежнему идут в origin). Setup: docs/CDN_SETUP.md.
CDN_BASE_URL=
# Sweep-ключи (отдельный сервис-аккаунт с list+delete на bucket).
S3_SWEEP_ACCESS_KEY=
S3_SWEEP_SECRET_KEY=
# Min. возраст объекта до удаления как orphan. Должен быть > presign-expiry
# (15m), 24h с запасом покрывает любые задержки между PUT и записью в БД.
S3_ORPHAN_MIN_AGE=24h
# Периодичность sweep'a в worker'е. <=0 выключает таск.
S3_SWEEP_INTERVAL=6h

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.anthropic.com
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60s
LLM_EFFORT=medium

JWT_SECRET=please-change-me-in-prod-32-bytes-min
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

SUMMARIZE_CACHE_TTL=10m
RATE_SUMMARIZE_PER_MIN=5
RATE_SUMMARIZE_PER_HOUR=30
RATE_READ_PER_MIN=60
RATE_READ_PER_HOUR=600
RATE_LEADS_PER_MIN=5
RATE_LEADS_PER_HOUR=20
RATE_AUTH_PER_MIN=10
RATE_AUTH_PER_HOUR=60

# ── Email verification ──────────────────────────────────────────────
# Для локального запуска по дефолту verification выключен: юзеры сразу
# email_verified=true при регистрации, soft-gate на /me/profile/publish
# и POST /leads пропускает. В проде .env.prod должен ставить =false.
EMAIL_VERIFICATION_DISABLED=true

# Реальная отправка письма идёт через n8n (см. N8N_EMAIL_WEBHOOK_URL ниже).
# Если он пустой — verify-URL печатается в stdout воркера, копируй руками.
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFY_TOKEN_TTL=24h
RATE_EMAIL_RESEND_PER=60s

# Outbox-воркер: backoff/DLQ/TTL. После OUTBOX_MAX_ATTEMPTS неуспехов
# событие уезжает в DLQ (dead_at NOT NULL) и больше не ретраится.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_CAP=10m
OUTBOX_RETENTION=168h
# Мёртвые записи (DLQ) храним дольше — это описание происшествия. 4320h = 180 дней.
OUTBOX_DEAD_RETENTION=4320h
OUTBOX_CLEANUP_INTERVAL=1h
WORKER_METRICS_ADDR=:9090

LOG_LEVEL=debug

# Разрешённые origin'ы фронта (через запятую). Пусто = CORS-заголовки
# не выставляются (фронт обслуживается с того же домена через прокси).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CRM v5: webhook n8n для нотификаций project.* событий. Пусто →
# диспатчер выключен, события квитируются как no-op (не зависают
# в outbox). URL — production-URL Webhook node'a в n8n.
# Token — опциональный bearer для аутентификации (рекомендуется в проде).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Отдельный workflow для email.* событий (verify + password reset).
# Пусто → email шлёт встроенный mailer (UniSender Go); если и mailer
# пустой — событие пишется в log. См. deploy/n8n/workflows/crmEmailNotify.json
N8N_EMAIL_WEBHOOK_URL=

# Workflow для обращений в поддержку из футера UI (event support.message_received).
# Пусто → запись в БД остаётся, но в Telegram не уходит.
# См. deploy/n8n/workflows/crmSupport.json
N8N_SUPPORT_WEBHOOK_URL=

# ── Телеграм-боты ───────────────────────────────────────────────────
# Ботов два: креаторский (исполнителю) и клиентский (заказчику).
# Менеджерского нет и не будет — всё, что адресовано менеджеру, уходит
# в общий чат менеджеров через N8N_WEBHOOK_URL.
#
# Токены нужны НАМ для проверки подписи мини-аппа (initData): это
# чистая криптография над токеном, и делать её на стороне бота значит
# уронить вход в мини-апп вместе с ним. Пусто → вход через этого бота
# отвечает 501 «не настроен», а не пятисоткой.
TELEGRAM_CREATOR_BOT_TOKEN=
TELEGRAM_CREATOR_BOT_USERNAME=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
# Сколько живёт подписанная строка мини-аппа. Webview держат открытым
# сутками: слишком короткий срок выкидывает живого человека.
TELEGRAM_INITDATA_TTL=24h

# Уведомления в телеграм-ботов БОЛЬШЕ НЕ ШЛЮТСЯ ОТСЮДА.
#
# Было: воркер слал HTTP-запрос в сервис бота (BOT_WEBHOOK_*). Первого
# октября 2026 уведомление потерялось — маршрут с российской ВДС до
# Railway обрывался внутри сети хостера, и десять попыток ушли в
# пустоту. Доставка не должна зависеть от того, дозвонится ли наша ВДС
# до чужого облака.
#
# Стало: воркер кладёт сообщение в таблицу bot_messages, сервис бота
# забирает его сам через GET /api/v1/bot/messages и квитирует. Это
# направление работает всегда — на нём же живут привязка и мини-апп.
# Переменные BOT_WEBHOOK_* больше не нужны и удалены.
#
# Общий секрет для входящих /api/v1/bot/* (бот → мы: привязка, «кто
# это», блокировка, очередь сообщений). Пусто → группа ручек не
# поднимается вовсе, и уведомления копятся в таблице.
BOT_SHARED_SECRET=

# ── Сбор статистики по сданным ссылкам (instacurl) ───────────────────
#
# Без ОБЕИХ переменных сбор не поднимается вовсе: клиент не создаётся,
# тикер не запускается, в логе воркера один warn «stats collection
# disabled». Просмотры в кабинете при этом остаются нулями, а ноль
# читается менеджером как «ролик никто не смотрит» — поэтому и алерт
# StatsNeverCollected, а не только строка в логе.
#
# ВНИМАНИЕ про имя. У Alloy есть своя переменная INSTACURL_HOST — тот
# же сервис, но в виде «10.x.x.x:8000» для скрейпа /metrics. Это НЕ
# замена INSTACURL_URL: воркеру нужен адрес со схемой. Первого октября
# 2026 на проде стояла только HOST, и сбор молча не работал — ровно
# потому, что здесь, в примере окружения, про URL не было сказано
# ничего, и при настройке её просто не прописали.
INSTACURL_URL=
INSTACURL_API_KEY=
# Сервис ходит в площадки через Playwright: медленный ответ — норма.
INSTACURL_TIMEOUT=60s
# Как часто воркер проверяет очередь. Частоту обхода задаёт расписание
# самой ссылки, а не это число, поэтому частый тик кредитов не жжёт: когда
# брать нечего, тик стоит один запрос по индексу. Минута нужна не для
# фонового расписания (оно суточное), а для только что сданной ссылки:
# она приходит с next_collect_at = now(), и при часовом тике первый замер
# ждал бы до часа.
STATS_COLLECT_INTERVAL=1m
STATS_COLLECT_BATCH=10
STATS_COLLECT_BATCHES_PER_TICK=20
