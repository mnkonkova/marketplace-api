.env
.env.local
# Резервные копии окружения. В них лежат живые ключи — JWT_SECRET, доступы
# к S3, к базе, к LLM, — и однажды такой файл уже уехал в коммит: пуш
# отбила защита GitHub, а история чинилась переписыванием.
.env.bak-*
.env.*.bak
*.local
bin/
tmp/
.idea/
.vscode/
.DS_Store
coverage.out
conversation-*.txt
.claude/settings.local.json
node_modules/
# pg_dump архивы от `make prod-backup-db` — лежат на проде, в git не нужны.
backups/

# Скомпилированные бинарники в корне репо (через `go build ./cmd/api` и т.п.).
# В прод они собираются на VDS внутри Docker, локально могут случайно
# оказаться рядом — в git не нужны.
/api
/worker
/seed
/backfill-previews
.env.prod

# Стенограммы сессий и питоновский кеш скриптов — локальный мусор.
2026-*-*.txt
scripts/__pycache__/
