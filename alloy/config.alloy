// Grafana Alloy: единый агент сбора observability-данных на VDS.
// Скрейпит /metrics с api и node-exporter (CPU/RAM/диск), тянет логи всех
// docker-контейнеров и пушит всё в Grafana Cloud по remote_write/push.
//
// Конфиг написан на Alloy River-syntax. Документация:
//   https://grafana.com/docs/alloy/latest/reference/components/

// ── Метрики Go API ─────────────────────────────────────────────────
// Alloy ходит по docker-сети к api:8080/metrics. Эндпоинт виден только
// изнутри сети (Caddy /metrics не проксирует).
prometheus.scrape "api" {
	targets = [
		{
			__address__ = "api:8080",
			service     = "api",
			job         = "marketpclce-api",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Метрики outbox-воркера ──────────────────────────────────────────
// У воркера отдельный HTTP-listener на 9090 (см. cmd/worker/main.go) —
// бизнес-API нет, только /metrics и /healthz. Видно изнутри docker-сети.
prometheus.scrape "worker" {
	targets = [
		{
			__address__ = "worker:9090",
			service     = "worker",
			job         = "marketpclce-worker",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── n8n availability через scrape /metrics ─────────────────────────
// n8n отдаёт Prometheus metrics на /metrics если контейнер запущен
// с env N8N_METRICS=true (см. docs/VDS_SETUP.md §7 — `docker run`
// для n8n должен включать `-e N8N_METRICS=true`). Без этого endpoint
// возвращает 404 или другой формат → up=0 даже когда n8n живой.
prometheus.scrape "n8n_metrics" {
	targets = [
		{
			__address__ = "marketplace-api-n8n-1:5678",
			service     = "n8n",
			job         = "marketpclce-n8n",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "1m"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Хост-метрики (CPU/RAM/диск/сеть VDS) ───────────────────────────
prometheus.scrape "node" {
	targets = [
		{
			__address__ = "node-exporter:9100",
			service     = "node",
			job         = "node-exporter",
		},
	]
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Метрики по контейнерам (cAdvisor) ──────────────────────────────
// node-exporter показывает память ХОСТА, а контейнеры живут в своих
// cgroup'ах со своими mem_limit. Разница неприятная: 2026-08-17 opensearch
// стоял на 99% собственного лимита и тормозил поиск, при этом на VDS было
// 13 ГБ свободных — хост-алерт OOMRisk молчал, потому что с его точки
// зрения всё прекрасно. cAdvisor даёт container_memory_* / container_cpu_*
// в разрезе контейнеров и закрывает эту слепую зону.
//
// Встроенный экспортер Alloy — отдельный контейнер поднимать не нужно, но
// нужны host-моунты (см. docker-compose.prod.yml, сервис alloy).
prometheus.exporter.cadvisor "containers" {
	// docker_host НЕ задаём намеренно. На этом хосте Docker работает с
	// containerd-снапшоттером (storage driver = overlayfs), а docker-обработчик
	// cAdvisor ищет метаданные слоёв в /var/lib/docker/image/overlayfs/layerdb/
	// — каталога при таком драйвере не существует, метаданные живут в
	// containerd. Итог: на каждый контейнер сыпалась ошибка «failed to
	// identify the read-write layer ID», а имена контейнеров всё равно
	// приходили пустыми (name="").
	//
	// Без docker.sock cAdvisor читает статистику прямо из cgroup: ошибок ноль,
	// метрики те же. Проверено на этом хосте: 56 серий памяти, 55 лимитов,
	// 0 ошибок в логе (с сокетом было 18-21 ошибка и те же метрики).
	//
	// Плата — контейнер опознаётся по cgroup-пути в метке id, а не по имени.
	// Ниже вытаскиваем из него короткий id, чтобы алерт был читаемым.
	enabled_metrics = ["cpu", "memory", "network"]
	storage_duration = "5m"
}

// id вида "/system.slice/docker-<64 hex>.scope" → короткий хеш в отдельной
// метке: по нему сразу работает `docker ps --filter id=<hash>`.
prometheus.relabel "cadvisor_container_id" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["id"]
		regex         = "/system\\.slice/docker-([0-9a-f]{12})[0-9a-f]*\\.scope"
		target_label  = "container_id"
		replacement   = "$1"
	}
}

prometheus.scrape "cadvisor" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.cadvisor_container_id.receiver]
}

// ── Remote-write метрик в Grafana Cloud ────────────────────────────
prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")
		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_PROM_KEY")
		}
	}
	external_labels = {
		instance = "marketpclce-prod",
	}
}

// ── Логи docker-контейнеров → Loki ─────────────────────────────────
// discovery.docker сам находит все запущенные контейнеры (читает
// /var/run/docker.sock смонтированный в контейнер Alloy). relabel
// превращает имя контейнера "/marketpclce-api-1" в метку container="api".
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.grafana_cloud.receiver]
	labels = {
		instance = "marketpclce-prod",
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")
		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_LOKI_KEY")
		}
	}
}
