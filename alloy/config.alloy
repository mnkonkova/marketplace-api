// Grafana Alloy: единый агент сбора observability-данных на VDS.
// Скрейпит /metrics с api и node-exporter (CPU/RAM/диск), тянет логи всех
// docker-контейнеров и пушит всё в Grafana Cloud по remote_write/push.
//
// Конфиг написан на Alloy River-syntax. Документация:
//   https://grafana.com/docs/alloy/latest/reference/components/

// ── Метрики Go API ─────────────────────────────────────────────────
// Alloy ходит по docker-сети к api:8080/metrics. Эндпоинт виден только
// изнутри сети (Caddy /metrics не проксирует).
prometheus.scrape "api" {
	targets = [
		{
			__address__ = "api:8080",
			service     = "api",
			job         = "marketpclce-api",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Метрики outbox-воркера ──────────────────────────────────────────
// У воркера отдельный HTTP-listener на 9090 (см. cmd/worker/main.go) —
// бизнес-API нет, только /metrics и /healthz. Видно изнутри docker-сети.
prometheus.scrape "worker" {
	targets = [
		{
			__address__ = "worker:9090",
			service     = "worker",
			job         = "marketpclce-worker",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── n8n availability через scrape /metrics ─────────────────────────
// n8n отдаёт Prometheus metrics на /metrics если контейнер запущен
// с env N8N_METRICS=true (см. docs/VDS_SETUP.md §7 — `docker run`
// для n8n должен включать `-e N8N_METRICS=true`). Без этого endpoint
// возвращает 404 или другой формат → up=0 даже когда n8n живой.
prometheus.scrape "n8n_metrics" {
	targets = [
		{
			__address__ = "marketplace-api-n8n-1:5678",
			service     = "n8n",
			job         = "marketpclce-n8n",
		},
	]
	metrics_path    = "/metrics"
	scrape_interval = "1m"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Метрики instacurl (отдельная VDS, приватная сеть) ──────────────
// Instacurl живёт не в этой docker-сети, а на своей машине — ходим к нему
// по приватной сети Timeweb, тому же адресу, по которому api зовёт
// /collect. Поэтому адрес не имя контейнера, а IP:порт из переменной.
//
// bearer_token, а не X-API-Key: произвольные заголовки Alloy слать не
// умеет, и ради этого /metrics научили принимать оба варианта.
//
// Если INSTACURL_HOST пуст, неработающим окажется только этот скрейп —
// остальные компоненты Alloy независимы и продолжат пушить.
prometheus.scrape "instacurl" {
	targets = [
		{
			__address__ = sys.env("INSTACURL_HOST"),
			service     = "instacurl",
			job         = "instacurl",
		},
	]
	metrics_path = "/metrics"
	// Реже, чем остальные: метрики тут медленные (остаток кредитов,
	// отставание сбора), а лишние серии стоят денег в Grafana Cloud.
	scrape_interval = "60s"
	bearer_token    = sys.env("INSTACURL_API_KEY")
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Хост-метрики (CPU/RAM/диск/сеть VDS) ───────────────────────────
prometheus.scrape "node" {
	targets = [
		{
			__address__ = "node-exporter:9100",
			service     = "node",
			job         = "node-exporter",
		},
	]
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Метрики по контейнерам (cAdvisor) ──────────────────────────────
// node-exporter показывает память ХОСТА, а контейнеры живут в своих
// cgroup'ах со своими mem_limit. Разница неприятная: 2026-08-17 opensearch
// стоял на 99% собственного лимита и тормозил поиск, при этом на VDS было
// 13 ГБ свободных — хост-алерт OOMRisk молчал, потому что с его точки
// зрения всё прекрасно. cAdvisor даёт container_memory_* / container_cpu_*
// в разрезе контейнеров и закрывает эту слепую зону.
//
// Встроенный экспортер Alloy — отдельный контейнер поднимать не нужно, но
// нужны host-моунты (см. docker-compose.prod.yml, сервис alloy).
prometheus.exporter.cadvisor "containers" {
	// Docker-обработчик выключаем ЯВНО, несуществующим адресом сокета.
	//
	// Раньше здесь стояло «docker_host не задаём намеренно» — в расчёте на
	// то, что без него обработчик не поднимется. Это неверно: у cAdvisor
	// адрес по умолчанию `unix:///var/run/docker.sock`, а этот сокет в
	// контейнер Alloy смонтирован (он нужен discovery.docker для меток
	// логов). Обработчик поднимался, ЗАБИРАЛ себе контейнерные cgroup'ы и
	// тут же падал на их опознании:
	//
	//   failed to identify the read-write layer ID … open
	//   /rootfs/var/lib/docker/image/overlayfs/layerdb/mounts/<id>/mount-id:
	//   no such file or directory
	//
	// Причины две и обе неустранимы на этом хосте: Docker работает через
	// containerd-снапшоттер, и каталога layerdb не существует вовсе; плюс
	// моунт /rootfs убран ради безопасности. А контейнер, который забрал
	// docker-обработчик и не смог опознать, не достаётся уже никому —
	// поэтому в Grafana приходили только системные слайсы, ни одного ряда
	// с container_id, и алерт ContainerMemoryNearLimit молчал не потому,
	// что всё хорошо, а потому, что сравнивать было не с чем (26.09.2026).
	//
	// С заведомо мёртвым адресом фабрика docker не регистрируется вовсе, и
	// cgroup'ы достаются containerd-обработчику (его сокет отдан только на
	// чтение) и сырому cgroup-обходчику. Имя контейнера при этом не
	// приходит — опознаём по cgroup-пути, см. relabel ниже.
	docker_host = "unix:///var/lib/alloy/docker-handler-disabled.sock"

	enabled_metrics  = ["cpu", "memory", "network"]
	storage_duration = "5m"
}

// id вида "/system.slice/docker-<64 hex>.scope" → короткий хеш в отдельной
// метке: по нему сразу работает `docker ps --filter id=<hash>`.
prometheus.relabel "cadvisor_container_id" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["id"]
		regex         = "/system\\.slice/docker-([0-9a-f]{12})[0-9a-f]*\\.scope"
		target_label  = "container_id"
		replacement   = "$1"
	}
}

prometheus.scrape "cadvisor" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.cadvisor_container_id.receiver]
}

// ── Remote-write метрик в Grafana Cloud ────────────────────────────
prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")
		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_PROM_KEY")
		}
	}
	external_labels = {
		instance = "marketpclce-prod",
	}
}

// ── Логи docker-контейнеров → Loki ─────────────────────────────────
// discovery.docker сам находит все запущенные контейнеры (читает
// /var/run/docker.sock смонтированный в контейнер Alloy). relabel
// превращает имя контейнера "/marketpclce-api-1" в метку container="api".
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host    = "unix:///var/run/docker.sock"
	targets = discovery.relabel.containers.output
	// Через фильтр давности, а не прямо в loki.write: см. ниже.
	forward_to = [loki.process.drop_ancient.receiver]
	labels     = {
		instance = "marketpclce-prod",
	}
}

// Отбрасываем строки старше суток — иначе доставка логов встаёт колом.
//
// Grafana Cloud на нашем тарифе не принимает записи старше недели и
// отвечает на такую пачку 400: «has timestamp too old». Alloy считает
// это ошибкой доставки и ретраит ту же пачку — то есть очередь
// затыкается древними строками, а СВЕЖИЕ логи не доезжают вовсе.
//
// Откуда берутся древние: при пересоздании контейнера Alloy позиции
// чтения по некоторым целям начинаются заново, и он честно вычитывает
// docker-лог контейнера, живущего с июля, с самого начала. 27.09.2026
// так и вышло — после починки cAdvisor в логе висели строки от
// 10 июля и батч уходил в 400 по кругу.
//
// Сутки, а не неделя: запас к границе облака нужен на случай, когда
// контейнер простоял выключенным пару дней, а его лог всё ещё
// вычитывается. Отброшенные считаются метрикой
// loki_process_dropped_lines_total с причиной ниже — «молча потеряли»
// и «сознательно не повезли» должны различаться.
loki.process "drop_ancient" {
	forward_to = [loki.write.grafana_cloud.receiver]

	stage.drop {
		older_than          = "24h"
		drop_counter_reason = "too_old_for_cloud"
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")
		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_LOKI_KEY")
		}
	}
}
